# Sunucu tarafı değişkenler. Hiçbiri NEXT_PUBLIC_ ile başlamamalı.
# ADMIN_PASSWORD_HASH ve SESSION_SECRET için: node scripts/generate-admin-credentials.mjs

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# İletişim formu (Gmail uygulama şifresi)
EMAIL_USER=
EMAIL_PASS=

# Sitenin genel adresi. CSRF (Origin) kontrolü bunu kullanır; ters proxy (Dokploy/Traefik) arkasında ZORUNLU.
# Birden fazla adres virgülle: https://beyda.dev,https://www.beyda.dev
# Yerel geliştirmede boş bırakılabilir.
SITE_URL=

# Uygulamanın önündeki güvenilir proxy sayısı (istemci IP'si / rate limit için).
# Dokploy (Traefik) = 1; önünde Cloudflare da varsa = 2.
TRUSTED_PROXY_HOPS=1
